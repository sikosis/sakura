resource app_signature "application/x-vnd.sikosis-Sakura";

resource app_version {
	major = 0, middle = 1, minor = 0,
	variety = B_APPV_DEVELOPMENT, internal = 0,
	short_info = "Sakura 0.1",
	long_info = "A native music library and player for Haiku"
};

resource app_flags B_SINGLE_LAUNCH;

resource file_types message {
	"types" = "audio"
};

resource(100, "about-icon.png") #'PNG ' import "icon.png";
